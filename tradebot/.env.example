# ---- режим -------------------------------------------------------------
TB_MODE=paper                 # paper = виртуальные деньги на живых ценах, live = реальные
TB_EXCHANGE=binance           # binance | bybit | okx | kraken | ... (любой id из ccxt)
TB_MARKET_TYPE=spot           # spot (только лонг) | swap (бессрочные фьючерсы, лонг+шорт)
TB_SANDBOX=false              # testnet биржи, если поддерживается

# ---- ключи (ТОЛЬКО права на торговлю, вывод средств ЗАПРЕЩЁН, IP whitelist) ----
TB_API_KEY=
TB_API_SECRET=
TB_API_PASSWORD=              # passphrase для OKX / KuCoin

# ---- что торгуем -------------------------------------------------------
TB_SYMBOLS=BTC/USDT,ETH/USDT
TB_TIMEFRAME=1h
TB_STRATEGY=ema_trend         # ema_trend | mean_reversion
TB_STRATEGY_PARAMS=           # JSON, напр. {"fast":20,"slow":50,"adx_min":20}

# ---- деньги и риск -----------------------------------------------------
TB_STARTING_CASH=50           # виртуальный баланс для paper
TB_RISK_PER_TRADE_PCT=1.0     # потеря при срабатывании стопа, % от капитала
TB_MAX_POSITION_PCT=50        # максимум в одной позиции, % от капитала
TB_MAX_OPEN_POSITIONS=2
TB_MAX_DAILY_LOSS_PCT=3       # после этого до конца дня новых входов нет
TB_MAX_DRAWDOWN_PCT=15        # kill switch: всё закрыть и остановиться
TB_MIN_NOTIONAL=10            # минимальный ордер биржи в USDT
TB_FEE_PCT=0.1
TB_SLIPPAGE_PCT=0.05
TB_ALLOW_SHORT=false          # для live требует TB_MARKET_TYPE=swap
TB_LEVERAGE=1

# ---- доступ ------------------------------------------------------------
TB_WEB_HOST=0.0.0.0
TB_WEB_PORT=8080
TB_WEB_TOKEN=change-me-long-random-string
TB_TELEGRAM_TOKEN=
TB_TELEGRAM_CHAT_ID=

TB_POLL_SECONDS=30
TB_DATA_DIR=data
TB_LOG_LEVEL=INFO

# ---- три вкладки: Акции / Ценные бумаги / Крипто -------------------------
TB_CONFIG_FILE=config.yaml    # необязательно; без файла используются вкладки по умолчанию
TB_ALPACA_KEY=                # US акции и ETF: ключи paper-счёта с app.alpaca.markets
TB_ALPACA_SECRET=
TB_ALPACA_LIVE=false          # true = реальный счёт Alpaca (ключи live)
TB_ALPACA_FEED=iex            # бесплатные данные; sip = платная подписка
TB_TINVEST_TOKEN=             # Т-Инвестиции (MOEX): токен из настроек, sandbox по умолчанию
TB_TINVEST_ACCOUNT_ID=
TB_TINVEST_SANDBOX=true

# ---- модуль событий: новости мира -> торговые идеи --------------------------
TB_ANTHROPIC_API_KEY=         # ключ Claude API; пусто = простой аналитик по ключевым словам
TB_INTEL_ENABLED=true
TB_INTEL_MODE=confirm         # off | advise (только показывать) | confirm (вы одобряете) | auto
TB_INTEL_MODEL=claude-opus-5-5
TB_INTEL_INTERVAL_MINUTES=15
TB_INTEL_MIN_CONFIDENCE=0.65  # ниже — идея только в журнал
TB_INTEL_AUTO_CONFIDENCE=0.85 # в режиме auto исполняется без подтверждения
TB_INTEL_MAX_POSITION_PCT=10  # максимум на одну идею, % капитала вкладки
TB_INTEL_MAX_OPEN=3           # одновременно открытых позиций по идеям
TB_INTEL_PROPOSAL_TTL_HOURS=6 # неподтверждённая идея истекает
TB_INTEL_SOURCES=gdelt,rss    # gdelt, rss, newsapi, custom
TB_INTEL_RSS_FEEDS=           # свои RSS через запятую; пусто = встроенный список
TB_INTEL_NEWSAPI_KEY=
TB_INTEL_CUSTOM_URL=          # любой JSON-источник (ваш «инструмент событий»)
TB_INTEL_CUSTOM_HEADERS=      # JSON, напр. {"Authorization":"Bearer ..."}
TB_INTEL_KEYWORDS=            # доп. термины для GDELT через запятую
